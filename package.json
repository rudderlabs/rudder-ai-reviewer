{
  "name": "@rudderstack/pr-reviewer",
  "version": "0.1.0",
  "description": "GitHub Action to analyze RudderStack SDK instrumentation changes in pull requests",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.ts -o dist && npm run clean:declarations",
    "clean:declarations": "find dist -name '*.d.ts' -delete && find dist -name '*.d.ts.map' -delete && find dist -type d -empty -delete",
    "dev": "tsc --watch",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "lint": "eslint src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "setup": "npm install",
    "clean": "rm -rf dist node_modules"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudderlabs/pr-reviewer.git"
  },
  "keywords": [
    "github-action",
    "rudderstack",
    "analytics",
    "code-review",
    "instrumentation",
    "tracking"
  ],
  "author": "RudderStack",
  "license": "Elastic-2.0",
  "dependencies": {
    "@actions/artifact": "4.0.0",
    "@actions/core": "1.11.1",
    "@actions/github": "6.0.1",
    "@anthropic-ai/sdk": "0.71.0",
    "@octokit/rest": "22.0.1",
    "js-yaml": "4.1.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.10.1",
    "@typescript-eslint/eslint-plugin": "8.48.1",
    "@typescript-eslint/parser": "8.48.1",
    "@vercel/ncc": "0.38.4",
    "@vitest/coverage-v8": "4.0.15",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.7.4",
    "vitest": "4.0.15"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
