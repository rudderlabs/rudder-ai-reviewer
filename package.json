{
  "name": "rudderstack-pr-reviewer",
  "version": "1.0.0",
  "description": "GitHub Action to review PRs with RudderStack SDK integrations",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "package": "ncc build src/index.ts -o dist --source-map --license licenses.txt",
    "all": "npm run format && npm run lint && npm run build && npm run package"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudderlabs/pr-reviewer.git"
  },
  "keywords": [
    "github-action",
    "rudderstack",
    "code-review",
    "pr-review"
  ],
  "author": "RudderStack",
  "license": "Elastic-2.0",
  "dependencies": {
    "@actions/core": "^2.0.1",
    "@actions/github": "^6.0.1"
  },
  "devDependencies": {
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "@vercel/ncc": "^0.38.1",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  }
}
