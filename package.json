{
  "name": "rudderstack-pr-reviewer",
  "version": "1.0.0",
  "description": "GitHub Action to review PRs with RudderStack SDK integrations",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "watch": "tsc --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "all": "npm run format && npm run lint && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rudderlabs/pr-reviewer.git"
  },
  "keywords": [
    "github-action",
    "rudderstack",
    "code-review",
    "pr-review"
  ],
  "author": "RudderStack",
  "license": "Elastic-2.0",
  "dependencies": {
    "@actions/core": "^2.0.1",
    "@actions/github": "^9.0.0",
    "@babel/parser": "^7.26.3",
    "@babel/traverse": "^7.26.5",
    "@babel/types": "^7.26.3",
    "snyk-nodejs-lockfile-parser": "^2.4.4"
  },
  "devDependencies": {
    "@types/babel__traverse": "^7.20.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.4",
    "ts-jest": "^29.2.5",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.3.3"
  },
  "overrides": {
    "fastq": "1.17.1"
  }
}
